# =============================================================================
# InnoLab CTF Platform — consolidated environment variables
# =============================================================================
# Copy this file to `.env` and adjust values for your local / staging / prod
# environment. Docker Compose reads it automatically; native dev users can
# `set -a; source .env; set +a` after editing.
#
# Naming conventions:
#   - UPPER_SNAKE_CASE         → consumed directly by docker-compose / shell
#   - NEXT_PUBLIC_*            → exposed to the browser at build time
#   - spring.* / rate-limit.*  → Spring Boot relaxed-binding property names
#
# Anything marked (required) MUST be set in non-dev environments. Defaults shown
# in (parentheses) only apply when no override is supplied.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 — used by `db` service in docker-compose*)
# -----------------------------------------------------------------------------
POSTGRES_USER=ctfuser
POSTGRES_PASSWORD=ctfpass
POSTGRES_DB=ctf


# -----------------------------------------------------------------------------
# Backend — Spring Boot (ctf-backend)
# -----------------------------------------------------------------------------
# (required) JWT signing secret — must be strong (>=32 bytes) in production
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes

# (required) PostgreSQL JDBC URL
DATABASE_URL=jdbc:postgresql://localhost:5432/ctf

# (required) Comma-separated CORS allow-list (use no spaces around commas)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002

# (required) Backend → terminal gateway URL (HTTP)
# Compose default: http://terminal:3001   •   Native dev default: http://localhost:3001
TERMINAL_GATEWAY_URL=http://localhost:3001

# (optional) Docker socket for spawning challenge containers
DOCKER_HOST=unix:///var/run/docker.sock

# (optional) Directory holding challenge source files.
# Spring relaxed binding maps CHALLENGES_BASE_PATH -> property `challenges.base.path`.
# Native-dev default (from application-dev.properties): ${user.dir}/challenges
# Prod default (from application.properties): /opt/ctf/backend/challenges
CHALLENGES_BASE_PATH=./challenges

# (optional) Backend rolling-log path. Defaults to ./logs/ctf-backend.log.
# LOGGING_FILE_NAME=/opt/ctf/backend/logs/ctf-backend.log

# (optional) LDAP overrides (defaults point at FH Technikum Wien).
# Uncomment and edit to point the backend at a different LDAP server
# (e.g. for local testing). See AGENTS.md §9.1 for the full mapping.
# SPRING_LDAP_URLS=ldaps://ldap.technikum-wien.at:636
# SPRING_LDAP_BASE=ou=people,dc=technikum-wien,dc=at
# SPRING_LDAP_CONNECT_TIMEOUT_MS=5000

# (optional) Bootstrap admin usernames (comma-separated).
# Spring relaxed binding maps this -> property `app.auth.admin-users`.
APP_AUTH_ADMIN_USERS=

# (optional) Rate-limit tunables (see ctf-backend/.../config/RateLimitConfig.java).
# Spring relaxed binding maps each one to its hyphenated property.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=100
RATE_LIMIT_GLOBAL_DURATION_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_DURATION_SECONDS=60
RATE_LIMIT_FLAG_REQUESTS=30
RATE_LIMIT_FLAG_DURATION_SECONDS=60


# -----------------------------------------------------------------------------
# Frontend — Next.js (ctf-frontend)
# -----------------------------------------------------------------------------
# (server-side) Absolute base URL used inside Next.js server actions
#   Native dev: http://localhost:8080     •   Compose default: http://app:8080
API_URL=http://localhost:8080

# (server-side) Target for Next.js rewrites/api proxy
API_PROXY_TARGET=http://localhost:8080

# (client-side, exposed to the browser) Public API base URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# (client-side, exposed to the browser) Terminal WebSocket URL
#   No path suffix — ctf-terminal/server.js opens the WS at the root URL and
#   reads query params (containerName, instanceId, sshPort) from the URL.
#   Production is HTTP-only — use ws://, not wss:// until HTTPS is configured.
NEXT_PUBLIC_TERMINAL_URL=ws://localhost:3001

# (server/build) Terminal WebSocket URL for SSR / image generation contexts.
# Also consumed by the backend (Spring property `terminal.ws.url`) — keep this
# in sync with NEXT_PUBLIC_TERMINAL_URL unless you deliberately want a
# separate URL for SSR vs. browser.
TERMINAL_WS_URL=ws://localhost:3001


# -----------------------------------------------------------------------------
# Terminal Gateway — Node.js (ctf-terminal)
# -----------------------------------------------------------------------------
# (optional) HTTP/WebSocket listen port
PORT=3001

# (optional) true = connect via container DNS name:22 inside Docker;
#            false = connect via host 127.0.0.1:<sshPort> (30000-30999)
USE_DOCKER_DNS=false

# (required) SSH password the gateway uses to log into challenge containers.
# SECURITY: server.js refuses to start without this. Strictly local/controlled
# distribution; rotate if ever leaked. The backend applies it to each new
# challenge container, and the challenge entrypoint should honor it too.
CTF_SSH_PASSWORD=change-me-to-a-strong-container-ssh-password

# Optional: pino log level (trace|debug|info|warn|error|fatal). Defaults to info.
# LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# Notes for production
# -----------------------------------------------------------------------------
# - Replace every secret with a strong random value (use `openssl rand -hex 32`).
# - Set `USE_DOCKER_DNS=true` when running the full docker-compose stack.
# - TERMINAL_WS_URL and NEXT_PUBLIC_TERMINAL_URL must match protocol: ws:// for
#   HTTP deployments, wss:// once HTTPS is in place.
